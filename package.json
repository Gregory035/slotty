{
  "name": "slotty",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "node scripts/dev.mjs",
    "lint": "eslint . --max-warnings=0",
    "audit:production": "node scripts/audit-production.mjs",
    "smoke:auth": "node scripts/smoke-auth.mjs",
    "smoke:booking": "node scripts/smoke-booking.mjs",
    "smoke:catalog": "node scripts/smoke-catalog.mjs",
    "smoke:companies": "node scripts/smoke-companies.mjs",
    "smoke:scheduling": "node scripts/smoke-scheduling.mjs",
    "smoke:e2e": "npm run smoke:auth && npm run smoke:companies && npm run smoke:catalog && npm run smoke:booking",
    "test": "npm run test --workspaces --if-present",
    "test:e2e:web": "playwright test",
    "test:integration": "npm run test:integration -w @slotty/api",
    "test:coverage": "npm run test:coverage -w @slotty/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "prisma generate --schema=apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=apps/api/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=apps/api/prisma/schema.prisma"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "js-yaml": "5.4.3",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "multer": "2.4.0",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0",
    "@nestjs/swagger": {
      "js-yaml": "5.4.3"
    }
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.1": true
  }
}
