generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String               @id @default(uuid()) @db.Uuid
  email                String               @unique
  passwordHash         String
  firstName            String
  lastName             String?
  emailVerified        Boolean              @default(false)
  memberships          CompanyMember[]
  refreshTokens        RefreshToken[]
  auditLogs            AuditLog[]           @relation("AuditActor")
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  appointmentHistories AppointmentHistory[]
}

model Company {
  id                        String               @id @default(uuid()) @db.Uuid
  name                      String
  description               String?
  phone                     String?
  email                     String?
  address                   String?
  timezone                  String               @default("Europe/Moscow")
  currency                  String               @default("RUB") @db.Char(3)
  language                  String               @default("ru") @db.VarChar(5)
  logoUrl                   String?
  minBookingNoticeMinutes   Int                  @default(0)
  maxBookingHorizonDays     Int                  @default(14)
  slotStepMinutes           Int                  @default(15)
  cancellationNoticeMinutes Int                  @default(0)
  allowAnyEmployee          Boolean              @default(true)
  members                   CompanyMember[]
  bots                      Bot[]
  employees                 Employee[]
  services                  Service[]
  employeeServices          EmployeeService[]
  scheduleRules             ScheduleRule[]
  scheduleExceptions        ScheduleException[]
  customers                 Customer[]
  appointments              Appointment[]
  reviews                   Review[]
  notifications             Notification[]
  subscriptions             Subscription[]
  payments                  Payment[]
  auditLogs                 AuditLog[]
  appointmentHistory        AppointmentHistory[]
  outboxEvents              OutboxEvent[]
  telegramUpdates           TelegramUpdate[]
  paymentEvents             PaymentEvent[]
  waitlistEntries           WaitlistEntry[]
  rebookingDelayDays        Int                  @default(30)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  deletedAt                 DateTime?

  @@index([deletedAt])
}

model CompanyMember {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @db.Uuid
  companyId  String      @db.Uuid
  employeeId String?     @db.Uuid
  role       CompanyRole
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee?   @relation("EmployeeMembership", fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  createdAt  DateTime    @default(now())

  @@unique([userId, companyId])
  @@unique([id, companyId])
  @@unique([companyId, employeeId])
  @@index([companyId, role])
}

model Bot {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @db.Uuid
  telegramBotId   BigInt           @unique
  username        String
  tokenEncrypted  String
  webhookSecret   String           @unique
  status          BotStatus        @default(ACTIVE)
  errorMessage    String?
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  telegramUpdates TelegramUpdate[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([companyId])
  @@unique([id, companyId])
  @@index([companyId, status])
}

model Employee {
  id                 String              @id @default(uuid()) @db.Uuid
  companyId          String              @db.Uuid
  firstName          String
  lastName           String?
  phone              String?
  email              String?
  photoUrl           String?
  description        String?
  color              String              @default("#4F46E5") @db.VarChar(7)
  isActive           Boolean             @default(true)
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  services           EmployeeService[]
  scheduleRules      ScheduleRule[]
  scheduleExceptions ScheduleException[]
  appointments       Appointment[]
  waitlistEntries    WaitlistEntry[]
  memberships        CompanyMember[]     @relation("EmployeeMembership")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?

  @@unique([id, companyId])
  @@index([companyId, isActive, deletedAt])
}

model Service {
  id              String            @id @default(uuid()) @db.Uuid
  companyId       String            @db.Uuid
  name            String
  description     String?
  durationMinutes Int
  price           Decimal           @db.Decimal(12, 2)
  category        String?
  photoUrl        String?
  isActive        Boolean           @default(true)
  depositPercent  Int               @default(0)
  depositFixedAmount Decimal?       @db.Decimal(12, 2)
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees       EmployeeService[]
  appointments    Appointment[]
  waitlistEntries WaitlistEntry[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  @@unique([id, companyId])
  @@index([companyId, isActive, deletedAt])
}

model EmployeeService {
  companyId           String   @db.Uuid
  employeeId          String   @db.Uuid
  serviceId           String   @db.Uuid
  durationMinutes     Int?
  price               Decimal? @db.Decimal(12, 2)
  bufferBeforeMinutes Int      @default(0)
  bufferAfterMinutes  Int      @default(0)
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee            Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)
  service             Service  @relation(fields: [serviceId, companyId], references: [id, companyId], onDelete: Cascade)
  createdAt           DateTime @default(now())

  @@id([companyId, employeeId, serviceId])
  @@index([companyId])
  @@index([serviceId])
}

model ScheduleRule {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  employeeId String   @db.Uuid
  weekday    Int
  startTime  String   @db.VarChar(5)
  endTime    String   @db.VarChar(5)
  isWorking  Boolean  @default(true)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([id, companyId])
  @@index([companyId, employeeId, weekday])
}

model ScheduleException {
  id         String                @id @default(uuid()) @db.Uuid
  companyId  String                @db.Uuid
  employeeId String                @db.Uuid
  date       DateTime              @db.Date
  startTime  String?               @db.VarChar(5)
  endTime    String?               @db.VarChar(5)
  type       ScheduleExceptionType
  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee              @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@unique([id, companyId])
  @@index([companyId, employeeId, date])
}

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  companyId      String         @db.Uuid
  telegramId     BigInt?
  username       String?
  firstName      String
  lastName       String?
  phone          String?
  notes          String?
  isBlacklisted  Boolean        @default(false)
  anonymizedAt   DateTime?
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  reviews        Review[]
  notifications  Notification[]
  waitlistEntries WaitlistEntry[]
  createdAt      DateTime       @default(now())
  lastActivityAt DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([companyId, telegramId])
  @@unique([id, companyId])
  @@index([companyId, phone])
  @@index([companyId, lastActivityAt, id])
}

model Appointment {
  id                      String               @id @default(uuid()) @db.Uuid
  companyId               String               @db.Uuid
  customerId              String               @db.Uuid
  employeeId              String               @db.Uuid
  serviceId               String               @db.Uuid
  startsAt                DateTime
  endsAt                  DateTime
  status                  AppointmentStatus    @default(PENDING)
  source                  AppointmentSource    @default(TELEGRAM)
  notes                   String?
  cancellationReason      String?
  cancellationActor       String?
  cancelledAt             DateTime?
  customerConfirmedAt     DateTime?
  priceSnapshot           Decimal              @db.Decimal(12, 2)
  durationMinutesSnapshot Int
  depositAmountSnapshot   Decimal              @default(0) @db.Decimal(12, 2)
  depositStatus           DepositStatus        @default(NOT_REQUIRED)
  idempotencyKey          String?
  company                 Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer                Customer             @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)
  employee                Employee             @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  service                 Service              @relation(fields: [serviceId, companyId], references: [id, companyId], onDelete: Restrict)
  notifications           Notification[]
  history                 AppointmentHistory[]
  review                  Review?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@unique([id, companyId])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, startsAt, status])
  @@index([companyId, employeeId, startsAt, endsAt])
  @@index([companyId, customerId, startsAt])
}

model Review {
  id            String      @id @default(uuid()) @db.Uuid
  companyId     String      @db.Uuid
  customerId    String      @db.Uuid
  appointmentId String      @unique @db.Uuid
  rating        Int
  comment       String?
  commentRequestedAt DateTime?
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer    @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Cascade)
  appointment   Appointment @relation(fields: [appointmentId, companyId], references: [id, companyId], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([id, companyId])
  @@unique([appointmentId, companyId])
  @@index([companyId, createdAt])
  @@index([customerId, createdAt])
}

model Notification {
  id             String             @id @default(uuid()) @db.Uuid
  companyId      String             @db.Uuid
  customerId     String             @db.Uuid
  appointmentId  String?            @db.Uuid
  type           NotificationType
  status         NotificationStatus @default(PENDING)
  scheduledAt    DateTime
  sentAt         DateTime?
  errorMessage   String?
  attempts       Int                @default(0)
  lastError      String?
  idempotencyKey String
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer       Customer           @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Cascade)
  appointment    Appointment?       @relation(fields: [appointmentId, companyId], references: [id, companyId], onDelete: Cascade)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([companyId, idempotencyKey])
  @@unique([id, companyId])
  @@index([companyId, status, scheduledAt])
  @@index([appointmentId])
}

model WaitlistEntry {
  id          String         @id @default(uuid()) @db.Uuid
  companyId   String         @db.Uuid
  customerId  String         @db.Uuid
  employeeId  String         @db.Uuid
  serviceId   String         @db.Uuid
  desiredDate DateTime       @db.Date
  status      WaitlistStatus @default(WAITING)
  offeredAt   DateTime?
  expiresAt   DateTime?
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer       @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Cascade)
  employee    Employee       @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Cascade)
  service     Service        @relation(fields: [serviceId, companyId], references: [id, companyId], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([companyId, customerId, employeeId, serviceId, desiredDate])
  @@unique([id, companyId])
  @@index([companyId, status, desiredDate])
  @@index([companyId, employeeId, serviceId, desiredDate, status])
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  companyId              String             @db.Uuid
  plan                   SubscriptionPlan   @default(TRIAL)
  status                 SubscriptionStatus @default(TRIALING)
  trialEndsAt            DateTime?
  currentPeriodStartsAt  DateTime?
  currentPeriodEndsAt    DateTime?
  graceEndsAt            DateTime?
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  company                Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payments               Payment[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@unique([id, companyId])
  @@index([companyId, status])
}

model Payment {
  id                String           @id @default(uuid()) @db.Uuid
  companyId         String           @db.Uuid
  subscriptionId    String?          @db.Uuid
  provider          String
  externalPaymentId String
  amount            Decimal          @db.Decimal(12, 2)
  currency          String           @db.Char(3)
  status            PaymentStatus    @default(PENDING)
  planSnapshot      SubscriptionPlan
  paidAt            DateTime?
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription      Subscription?    @relation(fields: [subscriptionId, companyId], references: [id, companyId], onDelete: Restrict)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([id, companyId])
  @@unique([provider, externalPaymentId])
  @@index([companyId, status])
}

model PaymentEvent {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @db.Uuid
  provider        String
  externalEventId String
  payloadHash     String
  processedAt     DateTime @default(now())
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([provider, externalEventId])
  @@index([companyId, createdAt])
}

model RefreshToken {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  tokenHash       String    @unique
  familyId        String    @db.Uuid
  expiresAt       DateTime
  revokedAt       DateTime?
  rotatedAt       DateTime?
  reuseDetectedAt DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([familyId, expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  requestId  String?
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@unique([id, companyId])
  @@index([companyId, createdAt])
  @@index([actorId])
}

model AppointmentHistory {
  id               String                   @id @default(uuid()) @db.Uuid
  companyId        String                   @db.Uuid
  appointmentId    String                   @db.Uuid
  actorId          String?                  @db.Uuid
  action           AppointmentHistoryAction
  fromStatus       AppointmentStatus?
  toStatus         AppointmentStatus?
  previousStartsAt DateTime?
  previousEndsAt   DateTime?
  nextStartsAt     DateTime?
  nextEndsAt       DateTime?
  reason           String?
  company          Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointment      Appointment              @relation(fields: [appointmentId, companyId], references: [id, companyId], onDelete: Cascade)
  actor            User?                    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt        DateTime                 @default(now())

  @@index([companyId, appointmentId, createdAt])
}

model OutboxEvent {
  id             String       @id @default(uuid()) @db.Uuid
  companyId      String       @db.Uuid
  type           String
  aggregateType  String
  aggregateId    String
  payload        Json
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  availableAt    DateTime     @default(now())
  processedAt    DateTime?
  lastError      String?
  idempotencyKey String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([companyId, idempotencyKey])
  @@index([status, availableAt])
  @@index([companyId, createdAt])
}

model TelegramUpdate {
  id           String               @id @default(uuid()) @db.Uuid
  companyId    String               @db.Uuid
  botId        String               @db.Uuid
  updateId     BigInt
  payload      Json
  status       TelegramUpdateStatus @default(PENDING)
  attempts     Int                  @default(0)
  availableAt  DateTime             @default(now())
  processedAt  DateTime?
  errorMessage String?
  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bot          Bot                  @relation(fields: [botId, companyId], references: [id, companyId], onDelete: Cascade)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([botId, updateId])
  @@index([companyId, status, createdAt])
  @@index([status, availableAt])
}

enum CompanyRole {
  OWNER
  ADMIN
  EMPLOYEE
}

enum BotStatus {
  ACTIVE
  DISABLED
  ERROR
}

enum ScheduleExceptionType {
  DAY_OFF
  CUSTOM_HOURS
  VACATION
  SICK_LEAVE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_COMPANY
  NO_SHOW
}

enum AppointmentSource {
  TELEGRAM
  DASHBOARD
}

enum NotificationType {
  APPOINTMENT_CREATED
  APPOINTMENT_REMINDER
  APPOINTMENT_CHANGED
  APPOINTMENT_CANCELLED
  REBOOK_OFFER
  WAITLIST_SLOT
}

enum WaitlistStatus {
  WAITING
  OFFERED
  BOOKED
  CANCELLED
  EXPIRED
}

enum DepositStatus {
  NOT_REQUIRED
  PENDING
  PAID
  WAIVED
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum SubscriptionPlan {
  TRIAL
  STARTER
  PRO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum AppointmentHistoryAction {
  CREATED
  STATUS_CHANGED
  RESCHEDULED
  NOTE_CHANGED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  DEAD
}

enum TelegramUpdateStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}
