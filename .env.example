NODE_ENV=development
API_PORT=3000
# API_PUBLIC_URL=https://api.example.com
WEB_URL=http://localhost:5173
SEO_INDEXING_ENABLED=false
SWAGGER_ENABLED=true
VITE_API_URL=http://localhost:3000/api
# Production public URL, for canonical URLs and sitemap generation.
# SITE_URL=https://slotty.example.com
# VITE_SITE_URL=https://slotty.example.com
# Optional analytics IDs. Never send customer data as event parameters.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_YM_COUNTER_ID=12345678

POSTGRES_DB=telegram_business
POSTGRES_USER=telegram_business
POSTGRES_PASSWORD=telegram_business
DATABASE_URL=postgresql://telegram_business:telegram_business@localhost:5432/telegram_business?schema=public
REDIS_URL=redis://localhost:6379
REDIS_TIMEOUT_MS=1000
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_REFRESH_MAX=20
RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
RATE_LIMIT_WEBHOOK_MAX=120
RATE_LIMIT_WEBHOOK_WINDOW_SECONDS=60
RATE_LIMIT_AVAILABILITY_MAX=60
RATE_LIMIT_AVAILABILITY_WINDOW_SECONDS=60
RATE_LIMIT_CONNECT_BOT_MAX=5
RATE_LIMIT_CONNECT_BOT_WINDOW_SECONDS=3600

JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-32-character-secret
BOT_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-encryption-key

# YooKassa (optional until billing is enabled)
# YOOKASSA_SHOP_ID=your-shop-id
# YOOKASSA_SECRET_KEY=your-secret-key
# PAYMENT_RETURN_URL=https://app.example.com/billing
# PAYMENT_WEBHOOK_SECRET=replace-with-at-least-32-characters
# METRICS_TOKEN=replace-with-at-least-32-characters

# Optional sanitized 5xx error webhook
# ERROR_TRACKING_URL=https://errors.example.com/events
